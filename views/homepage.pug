head 
    title= `Homepage | Integrating With HubSpot I Practicum`
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
body    
    h1 Custom Object Table | Haustiere 

    a(href="/update-cobj" style="text-align: center; margin: 0 auto; max-width: fit-content;") Add to this table


    table
        thead
            tr
                td Name
                td Haustierart
                td Alter
        each haustier in data
            tr
                td #{haustier.properties.name}
                td #{haustier.properties.haustierart}
                td #{haustier.properties.alter}

